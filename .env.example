# Generic production variables for Render.
# Copy the keys into the Render dashboard. Do not commit real values.
# If a password contains $, write it as %24 inside DATABASE_URL.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=.example.com,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://*.onrender.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
WEB_CONCURRENCY=4

# Supabase session pooler (IPv4). The user is postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=aws-0-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.PROJECT_REF
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=require
POSTGRES_WAIT=false

# Optional. Cache and Celery stay unused until this points at a real Redis.
REDIS_URL=redis://redis:6379/0

# Supabase Storage, S3 protocol. Create these in Storage → S3 Access Keys.
# They are not the anon or service_role API keys.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
