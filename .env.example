# Fictional placeholders. Copy names into a gitignored file or the host dashboard.
# Do not put real passwords, keys, or project refs in this file.
# Docker Compose local reads .envs/.local/.django and .envs/.local/.postgres, not this file.

# --- local (config.settings.local, the manage.py default) ---
USE_DOCKER=yes
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=project_name
POSTGRES_USER=local-user
POSTGRES_PASSWORD=local-password-not-real

# --- tests (config.settings.test via pytest) ---
# Pytest uses the same POSTGRES_* names when DATABASE_URL is unset.
# It creates its own test database on that server. It does not read this file.

# --- production and a separate staging host (config.settings.production) ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=.example.com,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://*.onrender.com
DJANGO_DEBUG=false

# If DATABASE_URL is set, it wins over POSTGRES_*.
# A wrong URL is the database that migrate will change on boot.
DATABASE_URL=postgresql://postgres.exampleproject:replace-with-password@aws-0-example.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_HOST=aws-0-example.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.exampleproject
POSTGRES_PASSWORD=replace-with-password
POSTGRES_SSLMODE=require
POSTGRES_WAIT=false
CONN_MAX_AGE=60

# Leave all five empty to keep uploads on local disk.
# Set all five to use Supabase Storage. A partial set is ignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://exampleproject.storage.supabase.co/storage/v1/s3

REDIS_URL=redis://redis:6379/0
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=project_name <noreply@example.com>
DJANGO_ACCOUNT_ALLOW_REGISTRATION=true
